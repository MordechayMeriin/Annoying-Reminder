    <string name="setup_title">הגדרה</string>
    <string name="setup_intro">תזכורות עובדות רק אם הטלפון מעביר אותן. %1$d מתוך %2$d בוצעו. כל כפתור פותח את מסך ההגדרות המתאים; אחר כך חוזרים לכאן.</string>
    <string name="setup_allow">לאפשר</string>
    <string name="setup_open_settings">פתיחת ההגדרות</string>
    <string name="check_notifications">התראות</string>
    <string name="check_notifications_why">כל תזכורת היא התראה.</string>
    <string name="check_exact_alarms">שעונים מעוררים ותזכורות</string>
    <string name="check_exact_alarms_why">מאפשר לתזכורות להגיע בדיוק בזמן, גם כשהטלפון ישן. בלי זה הן עלולות לאחר בכמה דקות.</string>
    <string name="check_full_screen">התראות במסך מלא</string>
    <string name="check_full_screen_why">מאפשר להתראה למלא את המסך מעל מסך הנעילה, כמו אפליקציית השעון.</string>
    <string name="check_battery">סוללה: ללא הגבלה</string>
    <string name="check_battery_why">יש למצוא את ProMinder ברשימה ולבחור \"ללא אופטימיזציה\" (או \"ללא הגבלה\"), כדי ש-Android לא יעכב אותה כדי לחסוך בסוללה.</string>
    <string name="check_samsung">סמסונג: אף פעם לא במצב שינה</string>
    <string name="check_samsung_why">סמסונג מכניסה אפליקציות לשינה מעצמה. בהגדרות הסוללה יש לפתוח את ניהול צריכת החשמל של אפליקציות ← אפליקציות שלא יוכנסו למצב שינה (בטלפונים חדשים: הגבלות שימוש ברקע ← אפליקציות שאף פעם לא במצב שינה) ולהוסיף את ProMinder. אחר כך לחזור לכאן ולסמן.</string>
    <string name="check_dnd">דרך נא לא להפריע</string>
    <string name="check_dnd_why">תזכורות דחופות והתראות צריכות לעבור את מצב נא לא להפריע. יש להפעיל \"עקיפת נא לא להפריע\" (\"התעלמות מנא לא להפריע\" בסמסונג) עבור הקטגוריה %1$s.</string>

