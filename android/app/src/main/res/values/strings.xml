    <string name="check_notifications">Notifications</string>
    <string name="check_notifications_why">Every reminder is a notification.</string>
    <string name="check_exact_alarms">Alarms &amp; reminders</string>
    <string name="check_exact_alarms_why">Lets reminders arrive on the minute, even when the phone is asleep. Without it they can be minutes late.</string>
    <string name="check_full_screen">Full-screen alarms</string>
    <string name="check_full_screen_why">Lets the alarm fill the screen over the lock screen, like the clock app.</string>
    <string name="check_battery">Battery: unrestricted</string>
    <string name="check_battery_why">Find ProMinder in the list and choose \"Don\'t optimize\" (or \"Unrestricted\"), so Android doesn\'t delay it to save battery.</string>
    <string name="check_samsung">Samsung: never sleeping</string>
    <string name="check_samsung_why">Samsung puts apps to sleep on its own. In Battery, open App power management → Apps that won\'t be put to sleep (newer phones: Background usage limits → Never sleeping apps) and add ProMinder. Then come back and tick it here.</string>
    <string name="check_dnd">Through Do Not Disturb</string>
    <string name="check_dnd_why">Urgent reminders and alarms should get through Do Not Disturb. Turn on \"Override Do Not Disturb\" (\"Ignore Do Not Disturb\" on Samsung) for the %1$s category.</string>

