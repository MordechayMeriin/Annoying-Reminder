# The Lambda function's settings. On AWS they're the function's environment variables, which
# scripts/aws_lambda_setup.py sets (Lambda → prominder-api → Configuration → Environment variables to change one).
# Copy to .env only to run the scripts or tests against your own values. Never commit real values.

DYNAMODB_TABLE=prominder
# Google sign-in: the OAuth "Web application" client id, and the one Google account allowed in
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
OWNER_GOOGLE_EMAIL=you@gmail.com
# Signs the phone's login token (the setup script makes one up). Changing it logs the phone out.
ACTION_SECRET=
# Where the "phone has been silent for 2 days" email goes (default: OWNER_GOOGLE_EMAIL)
ALERT_EMAIL=

# OpenRouter: create a dedicated key with a monthly credit limit
OPENROUTER_API_KEY=sk-or-v1-...
# Comma-separated, first = preferred, must support tool calling. Check IDs at https://openrouter.ai/models
OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free

# Spend guards (on the server, so they hold even if the login were compromised)
LLM_CALLS_PER_DAY=300
LLM_PER_MINUTE=30
LLM_TIMEOUT_S=25
LLM_MAX_TOKENS=500
# Thinking effort for reasoning models: minimal | low | medium | high, or empty for the provider default.
# Reasoning tokens can count toward LLM_MAX_TOKENS: with medium/high, raise it (e.g. 2000).
LLM_REASONING_EFFORT=low
# The day the daily LLM cap counts in
TIMEZONE=Asia/Jerusalem

# The times, quiet hours, Shabbat and the other behaviour settings are on the phone (⚙ Settings).
