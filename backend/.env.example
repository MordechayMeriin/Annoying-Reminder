# Copy to .env for local runs. On Render, set these under Environment. Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (or Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Supabase → Authentication → Users → your user → copy the User UID
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# OpenRouter: create a dedicated key with a monthly credit limit
OPENROUTER_API_KEY=sk-or-v1-...
# Comma-separated, first = preferred. Check current IDs at https://openrouter.ai/models
OPENROUTER_MODELS=provider/cheap-paid-model,provider/fallback-model:free

# From: python backend/scripts/gen_secrets.py
CRON_SECRET=
ACTION_SECRET=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# URLs of the two Render services
WEB_ORIGIN=https://annoying-reminder-web.onrender.com
API_URL=https://annoying-reminder-api.onrender.com

# Optional: Pushover backup for critical reminders
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional behaviour (defaults shown)
TIMEZONE=Asia/Jerusalem
MORNING_TIME=07:30
CHECKIN_TIMES=13:00,17:00
EVENING_TIME=21:30
QUIET_START=23:00
QUIET_END=07:00
NAG_INTERVAL_MIN=30
MAX_NAGS=4
MEETING_LEAD_MIN=15
CHAT_PER_MINUTE=15
LLM_CALLS_PER_DAY=300
