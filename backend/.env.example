# Copy to .env for local runs. On Render, set these under Environment. Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (or Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Supabase → Authentication → Users → your user → copy the User UID
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# OpenRouter: create a dedicated key with a monthly credit limit
OPENROUTER_API_KEY=sk-or-v1-...
# Comma-separated, first = preferred, must support tool calling. Check IDs at https://openrouter.ai/models
# Free tier limits: 20 requests/min, 1,000/day.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free

# From: python backend/scripts/gen_secrets.py
CRON_SECRET=
ACTION_SECRET=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# URLs of the two Render services
WEB_ORIGIN=https://annoying-reminder-web.onrender.com
API_URL=https://annoying-reminder-api.onrender.com

# Optional: Pushover backup for critical reminders
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional behaviour (defaults shown)
TIMEZONE=Asia/Jerusalem
MORNING_TIME=07:30
CHECKIN_TIMES=13:00,17:00
EVENING_TIME=21:30
QUIET_START=23:00
QUIET_END=07:00
NAG_INTERVAL_MIN=30
MAX_NAGS=4
MEETING_LEAD_MIN=15
CHAT_PER_MINUTE=15
LLM_CALLS_PER_DAY=300
LLM_TIMEOUT_S=25
LLM_MAX_TOKENS=500

# Proactive-contact guardrails (enforced in code before any LLM call)
# minimum minutes between proactive messages (meetings exempt)
MIN_GAP_MIN=20
# all proactive messages per chat day (meetings skip it but count)
MAX_PROACTIVE_PER_DAY=20
# assistant check-ins per task per day (reminders you asked for don't count)
MAX_PER_TASK_PER_DAY=4
# follow-ups chosen by the LLM are clamped to 10 min ...
FOLLOWUP_MIN_MIN=10
# ... 7 days
FOLLOWUP_MAX_DAYS=7

# Conversation
# the chat "day" starts here; the LLM only sees messages since then
DAY_RESET_TIME=04:00
# a reply this soon after a check-in treats its tasks as the likely topic
REPLY_LINK_HOURS=3
