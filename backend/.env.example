# Copy to .env for local runs. On Render, set these under Environment. Never commit real values.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (or Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Supabase → Authentication → Users → your user → copy the User UID
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# OpenRouter: create a dedicated key with a monthly credit limit
OPENROUTER_API_KEY=sk-or-v1-...
# Comma-separated, first = preferred, must support tool calling. Check IDs at https://openrouter.ai/models
# Free tier limits: 20 requests/min, 1,000/day.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free

# From: python backend/scripts/gen_secrets.py
CRON_SECRET=
ACTION_SECRET=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# URLs of the two Render services
WEB_ORIGIN=https://annoying-reminder-web.onrender.com
API_URL=https://annoying-reminder-api.onrender.com

# Optional but recommended: Pushover (loud urgent alerts, repeating alarms). See README → Pushover.
# How it's used (every message / instead of browser push / backup) is set in the app (⚙ Settings).
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Times, delays, limits and Shabbat settings are edited in the app (⚙ Settings), not here.
# (Env vars with those names, e.g. MORNING_TIME, still work as defaults, but aren't needed.)

# Spend guards (server-side only, so they hold even if the login were compromised)
CHAT_PER_MINUTE=15
LLM_CALLS_PER_DAY=300
LLM_TIMEOUT_S=25
LLM_MAX_TOKENS=500
# Thinking effort for reasoning models: minimal | low | medium | high, or empty for the provider default.
# Reasoning tokens can count toward LLM_MAX_TOKENS: with medium/high, raise it (e.g. 2000).
LLM_REASONING_EFFORT=low
